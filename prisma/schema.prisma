generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  UNPAID
}

enum PlanInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum ContentType {
  CHAT
  TEXT
  IMAGE
  CODE
  VIDEO
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AgentTriggerType {
  MANUAL
  API
  WEBHOOK
  SCHEDULE
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  REQUIRES_APPROVAL
}

enum AgentStepType {
  PLAN
  ACTION
  TOOL
  OUTPUT
  APPROVAL
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum GeneratedPageType {
  TEMPLATE
  TOOL_EXAMPLES
  GENERATED_EXAMPLE
  BEST_AI_2026
  DALLE_PROMPTS
}

// ==================== AUTH MODELS ====================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role      @default(USER)
  credits        Json      @default("{\"text\": 0, \"image\": 0}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  chats              Chat[]
  messages           Message[]
  documents          Document[]
  generations        Generation[]
  createdAgents      Agent[]       @relation("AgentCreatedBy")
  requestedAgentRuns AgentRun[]    @relation("AgentRunRequestedBy")
  subscription       Subscription?
  teamMembers        TeamMember[]
  ownedTeams         Team[]        @relation("TeamOwner")
  activeTeamId       String?
  activeTeam         Team?         @relation("ActiveTeam", fields: [activeTeamId], references: [id])

  @@index([email])
  @@index([activeTeamId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CORE BUSINESS MODELS ====================

model Chat {
  id     String  @id @default(cuid())
  title  String  @default("New Chat")
  userId String
  teamId String?
  model  String  @default("gpt-4o")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([teamId])
}

model Message {
  id      String      @id @default(cuid())
  chatId  String
  userId  String?
  role    MessageRole
  content String      @db.Text
  model   String?
  tokens  Int         @default(0)

  createdAt DateTime @default(now())

  chat Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([chatId])
}

model Document {
  id         String  @id @default(cuid())
  title      String
  content    String? @db.Text
  userId     String
  teamId     String?
  templateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([teamId])
}

model Template {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  category        String
  icon            String?
  prompt          String   @db.Text
  fields          Json     @default("[]")
  active          Boolean  @default(true)
  builtIn         Boolean  @default(true)
  examplePrompt   String?  @db.Text
  sampleInput     Json?
  sampleOutput    Json?
  supportedModels String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      Document[]
  agents         Agent[]
  generatedPages GeneratedPage[]

  @@index([category])
  @@index([slug])
  @@index([active, category])
}

model Generation {
  id         String      @id @default(cuid())
  userId     String
  teamId     String?
  type       ContentType
  model      String
  input      String?     @db.Text
  output     String?     @db.Text
  imageUrl   String?
  videoUrl   String?
  tokens     Int         @default(0)
  creditCost Int         @default(1)

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ==================== AGENTS ====================

model Agent {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  goal         String? @db.Text
  systemPrompt String? @db.Text
  defaultModel String  @default("gpt-4o-mini")
  enabled      Boolean @default(true)
  maxSteps     Int     @default(8)
  maxCredits   Int     @default(25)
  toolConfig   Json    @default("{}")
  templateId   String?
  createdById  String
  teamId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template  Template?       @relation(fields: [templateId], references: [id])
  createdBy User            @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  team      Team?           @relation(fields: [teamId], references: [id])
  runs      AgentRun[]
  schedules AgentSchedule[]

  @@index([slug])
  @@index([enabled])
  @@index([createdById])
  @@index([teamId])
  @@index([templateId])
}

model AgentRun {
  id              String           @id @default(cuid())
  agentId         String
  requestedById   String?
  teamId          String?
  status          AgentRunStatus   @default(QUEUED)
  triggerType     AgentTriggerType @default(MANUAL)
  attemptCount    Int              @default(0)
  maxAttempts     Int              @default(3)
  workerId        String?
  lastHeartbeatAt DateTime?
  nextRetryAt     DateTime?
  input           Json             @default("{}")
  output          Json?
  summary         String?          @db.Text
  error           String?          @db.Text
  creditUsed      Int              @default(0)
  stepCount       Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestedBy User?       @relation("AgentRunRequestedBy", fields: [requestedById], references: [id])
  team        Team?       @relation(fields: [teamId], references: [id])
  steps       AgentStep[]

  @@index([agentId])
  @@index([requestedById])
  @@index([teamId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@index([nextRetryAt])
  @@index([triggerType])
  @@index([createdAt])
}

model AgentSchedule {
  id                String    @id @default(cuid())
  agentId           String
  name              String
  enabled           Boolean   @default(true)
  intervalMinutes   Int       @default(60)
  objectiveTemplate String    @db.Text
  lastDispatchedAt  DateTime?
  nextRunAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([enabled])
  @@index([nextRunAt])
  @@index([enabled, nextRunAt])
}

model AgentStep {
  id            String          @id @default(cuid())
  runId         String
  attemptNumber Int             @default(1)
  stepNumber    Int
  type          AgentStepType
  status        AgentStepStatus @default(PENDING)
  name          String
  rationale     String?         @db.Text
  toolName      String?
  input         Json?
  output        Json?
  error         String?         @db.Text
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attemptNumber, stepNumber])
  @@index([runId])
  @@index([attemptNumber])
  @@index([status])
  @@index([type])
}

model GeneratedPage {
  id          String            @id @default(cuid())
  slug        String
  pageType    GeneratedPageType
  templateId  String
  variantJson Json              @default("{}")
  variantHash String
  hitCount    Int               @default(0)
  published   Boolean           @default(true)
  lastHitAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([slug, pageType])
  @@unique([templateId, pageType, variantHash])
  @@index([pageType, published])
  @@index([hitCount])
  @@index([published, hitCount])
  @@index([createdAt])
}

// ==================== ANALYTICS ====================

model AnalyticsEvent {
  id        String  @id @default(cuid())
  eventName String
  eventType String  @default("event")
  source    String  @default("client")
  userId    String?
  teamId    String?
  visitorId String?
  sessionId String?
  path      String?
  url       String?
  referrer  String?
  userAgent String? @db.Text
  ipHash    String?
  params    Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([eventType, createdAt])
  @@index([source, createdAt])
  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
}

// ==================== BILLING ====================

model Plan {
  id              String       @id @default(cuid())
  name            String
  description     String?
  stripePriceId   String       @unique
  stripeProductId String
  price           Int
  interval        PlanInterval
  credits         Json         @default("{\"text\": 1000, \"image\": 50}")
  features        Json         @default("[]")
  active          Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  sortOrder       Int          @default(0)
  trialDays       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([userId])
}

// ==================== TEAMS ====================

model Team {
  id      String @id @default(cuid())
  name    String
  ownerId String
  credits Json   @default("{\"text\": 0, \"image\": 0}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invites     TeamInvite[]
  chats       Chat[]
  documents   Document[]
  generations Generation[]
  agents      Agent[]
  agentRuns   AgentRun[]
  activeUsers User[]       @relation("ActiveTeam")

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvite {
  id     String       @id @default(cuid())
  teamId String
  email  String
  role   TeamRole     @default(MEMBER)
  status InviteStatus @default(PENDING)
  token  String       @unique @default(cuid())

  createdAt DateTime @default(now())
  expiresAt DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}
