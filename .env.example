# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# First-party analytics is built-in (no env required). GA4 below is optional.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_API_SECRET=

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ayomagic"

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Providers (Phase 2)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Video (Replicate)
REPLICATE_API_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Agent Cron / Workers
AGENT_QUEUE_CRON_SECRET=

# pSEO page preseed cron (optional)
PSEO_CRON_SECRET=
# Optional pSEO crawl-budget controls (defaults shown in code)
# PSEO_NOINDEX_LOW_HIT_THRESHOLD=2
# PSEO_NOINDEX_LOW_HIT_AGE_DAYS=30
# PSEO_NOINDEX_RECENT_HIT_GRACE_DAYS=14
# PSEO_DISABLE_NOINDEX_POLICY=0
